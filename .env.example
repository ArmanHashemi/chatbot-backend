# Backend environment variables
# Copy this file to .env and adjust values as needed

# Backend port
PORT=3001

# Frontend origin for CORS (Quasar dev server default)
FRONTEND_ORIGIN=http://localhost:5173

# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/chatbot

# Auth
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# LLM endpoints
TEXT_URL=http://37.148.50.92:7860/
SPEECH_URL=http://37.148.50.92:7863/
SIMILARITY_URL=http://37.148.50.92:7863/
ASSIST_URL=http://37.148.50.92:7860/
ASSIST_PATH=/assist
ASSIST_TIMEOUT_MS=99999999

# Streaming LLM endpoint
STREAM_URL=http://78.39.10.7:7860/
STREAM_CHAT_PATH=/stream_chat

# Example: external API keys (do NOT commit real keys)
# OPENAI_API_KEY=

# Default admin seed (created on startup if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# Test user seed (created on startup for testing)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test1234

# Dify API Test Configuration
# These will be used for contract testing
DIFY_TEST_API_KEY=app-test-key-change-me-for-production
DIFY_TEST_USER_ID=test-user-id
DIFY_API_ENABLED=true

# Security Settings
PUBLIC_REGISTRATION_ENABLED=false

# Langfuse Observability Configuration
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://78.39.10.7:3000
LANGFUSE_PUBLIC_KEY=pk-lf-6dcf4133-d5b5-4cb5-af15-2572772ef591
LANGFUSE_SECRET_KEY=sk-lf-835a3892-d3f8-4e9a-967a-c917d50d3fdb
PROMPT_NAME=law_rag

